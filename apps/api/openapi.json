{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Access token yok ya da geçersiz."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Oturumdaki kullanıcı.",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "REGISTRATION_CLOSED"
          },
          "429": {
            "description": "İstek limiti aşıldı."
          }
        },
        "summary": "Sadece hiç kullanıcı yokken ilk kullanıcıyı oluşturur ve oturum açar.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS"
          },
          "429": {
            "description": "İstek limiti aşıldı."
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_REFRESH_TOKEN"
          },
          "429": {
            "description": "İstek limiti aşıldı."
          }
        },
        "security": [
          {
            "refresh_token": []
          }
        ],
        "summary": "Refresh token cookie'den okunur, rotation uygulanır ve yeni cookie yazılır.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          },
          "429": {
            "description": "İstek limiti aşıldı."
          }
        },
        "security": [
          {
            "refresh_token": []
          }
        ],
        "summary": "Refresh token ailesini iptal eder ve cookie'yi siler.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Tüm bağımlılıklar erişilebilir.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "Bir ya da daha fazla bağımlılık erişilemiyor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/dev/ping": {
      "post": {
        "operationId": "PingController_enqueue",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePingJobDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingJobResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "dev"
        ]
      }
    }
  },
  "info": {
    "title": "Seo Platform API",
    "description": "Çok kiracılı SEO takip ve otomasyon platformu API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "refresh_token": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    },
    "schemas": {
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lastLoginAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "lastLoginAt",
          "createdAt"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "password": {
            "type": "string",
            "description": "En az 8, en fazla 256 karakter.",
            "minLength": 8,
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Access token ömrü, saniye."
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "HealthCheckResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          },
          "latencyMs": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "$ref": "#/components/schemas/HealthCheckResultDto"
          },
          "redis": {
            "$ref": "#/components/schemas/HealthCheckResultDto"
          }
        },
        "required": [
          "database",
          "redis"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "type": "string"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "CreatePingJobDto": {
        "type": "object",
        "properties": {
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "orgId"
        ]
      },
      "PingJobResponseDto": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          }
        },
        "required": [
          "jobId"
        ]
      }
    }
  }
}
