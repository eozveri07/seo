  "info": {
    "title": "Seo Platform API",
    "description": "Çok kiracılı SEO takip ve otomasyon platformu API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "refresh_token": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      },
      "org": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Org-Id",
        "description": "Aktif organizasyon (TenantGuard)"
      }
    },
    "schemas": {
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lastLoginAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "lastLoginAt",
          "createdAt"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "password": {
            "type": "string",
            "description": "En az 8, en fazla 256 karakter.",
            "minLength": 8,
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Access token ömrü, saniye."
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "RegisterInvitedDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Davet bağlantısındaki token.",
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "password": {
            "type": "string",
            "description": "En az 8, en fazla 256 karakter.",
            "minLength": 8,
            "maxLength": 256
          }
        },
        "required": [
          "token",
          "name",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ReportBrandingDto": {
        "type": "object",
        "properties": {
          "logoUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "primaryColor": {
            "type": "string",
            "description": "`#1d4ed8` biçiminde.",
            "pattern": "^#?([0-9A-F]{3}|[0-9A-F]{4}|[0-9A-F]{6}|[0-9A-F]{8})$"
          }
        }
      },
      "OrganizationSettingsDto": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string",
            "description": "IANA saat dilimi, ör. `Europe/Istanbul`."
          },
          "defaultLanguage": {
            "type": "string",
            "description": "Varsayılan dil kodu, ör. `tr`.",
            "minLength": 2,
            "maxLength": 10
          },
          "reportBranding": {
            "$ref": "#/components/schemas/ReportBrandingDto"
          }
        }
      },
      "CreateOrganizationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "slug": {
            "type": "string",
            "description": "Küçük harf, rakam ve tire. Verilmezse addan üretilir.",
            "maxLength": 60
          },
          "settings": {
            "$ref": "#/components/schemas/OrganizationSettingsDto"
          }
        },
        "required": [
          "name"
        ]
      },
      "OrgRole": {
        "type": "string",
        "enum": [
          "owner",
          "admin",
          "analyst",
          "client_viewer"
        ]
      },
      "UserOrganizationResponseDto": {
        "type": "object",
        "properties": {
          "role": {
            "allOf": [
              {
