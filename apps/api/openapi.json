{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Tüm bağımlılıklar erişilebilir.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "Bir ya da daha fazla bağımlılık erişilemiyor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/dev/ping": {
      "post": {
        "operationId": "PingController_enqueue",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePingJobDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingJobResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "dev"
        ]
      }
    }
  },
  "info": {
    "title": "Seo Platform API",
    "description": "Çok kiracılı SEO takip ve otomasyon platformu API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthCheckResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          },
          "latencyMs": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "$ref": "#/components/schemas/HealthCheckResultDto"
          },
          "redis": {
            "$ref": "#/components/schemas/HealthCheckResultDto"
          }
        },
        "required": [
          "database",
          "redis"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "type": "string"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "CreatePingJobDto": {
        "type": "object",
        "properties": {
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "orgId"
        ]
      },
      "PingJobResponseDto": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          }
        },
        "required": [
          "jobId"
        ]
      }
    }
  }
}
